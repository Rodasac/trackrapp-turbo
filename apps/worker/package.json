{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "run-job": "tsx --env-file=.env src/run-job.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "pnpm dlx rimraf node_modules dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.76",
    "@ai-sdk/groq": "^3.0.39",
    "@ai-sdk/openai": "^3.0.63",
    "@repo/database": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/shared": "workspace:*",
    "ai": "^6.0.177",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^4.0.0",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^25.6.2",
    "@types/nodemailer": "^8.0.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-istanbul": "^4.1.6",
    "eslint": "^10.3.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.6"
  }
}
