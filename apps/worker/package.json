{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "run-job": "tsx --env-file=.env src/run-job.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "pnpm dlx rimraf node_modules dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.50",
    "@ai-sdk/groq": "^3.0.26",
    "@ai-sdk/openai": "^3.0.37",
    "@repo/database": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/shared": "workspace:*",
    "ai": "^6.0.105",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.5",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "pino-roll": "^1.3.0",
    "postgres": "^3.4.8",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^24.10.13",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-istanbul": "^4.0.18",
    "eslint": "^10.0.2",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
