# =============================================================================
# TrackrApp Deployment Environment Variables
# =============================================================================
# Copy this file to .env.staging or .env.prod on the VPS and fill in values.
# NEVER commit .env.staging or .env.prod to git.

# --- Docker image registry ---------------------------------------------------
# GitHub repository in owner/repo format (used to pull images from GHCR)
GITHUB_REPOSITORY=your-github-username/trackrapp

# Image tag to deploy (set by CI or manually for rollbacks)
IMAGE_TAG=latest

# --- Database ----------------------------------------------------------------
POSTGRES_DB=trackrapp
POSTGRES_USER=trackrapp
POSTGRES_PASSWORD=change-me-strong-password

# Full PostgreSQL connection string (used by web, worker, migrate)
DATABASE_URL=postgresql://trackrapp:change-me-strong-password@postgres:5432/trackrapp

# --- Better Auth -------------------------------------------------------------
BETTER_AUTH_SECRET=change-me-32-char-random-secret
# Full public URL of the web app (no trailing slash)
BETTER_AUTH_URL=https://trackrapp.xyz

# --- Google OAuth ------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (production: use a real SMTP provider) ----------------------------
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=re_...
EMAIL_FROM=noreply@trackrapp.xyz

# --- Push Notifications ------------------------------------------------------
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@trackrapp.xyz

# --- AI Tips -----------------------------------------------------------------
# Options: anthropic (default), openai
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# --- Uploadthing (avatar uploads) --------------------------------------------
UPLOADTHING_TOKEN=your-uploadthing-token

# --- Traefik -----------------------------------------------------------------
# Email for Let's Encrypt notifications
ACME_EMAIL=admin@trackrapp.xyz

# --- Dozzle (log viewer) basic auth ------------------------------------------
# Generate with: htpasswd -nb admin yourpassword
# Example: admin:$apr1$...
DOZZLE_BASIC_AUTH=admin:$$apr1$$change-me-hash
